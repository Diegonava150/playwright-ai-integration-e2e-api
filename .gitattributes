# Normalize line endings: LF in the repo, so Windows/macOS/Linux and the CI
# Ubuntu runners all agree. Stops the "LF will be replaced by CRLF" warnings.
* text=auto eol=lf

# Explicitly text
*.ts   text eol=lf
*.js   text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf

# Windows-only helper scripts (if ever added) keep CRLF
*.cmd  text eol=crlf
*.bat  text eol=crlf

# Binary — never touch
*.png  binary
*.jpg  binary
*.webm binary
*.zip  binary
*.ico  binary
